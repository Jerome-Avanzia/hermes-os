ANTHROPIC_API_KEY=

# Host UID/GID used when bind-mounting repositories and logs.
# Override on Linux servers where the operator UID is not 1000.
# Example: HERMES_UID=1001 / HERMES_GID=1001 for a non-default operator account.
# Set in /opt/avanzia/secrets/hermes.env on production VPS deployments.
HERMES_UID=1000
HERMES_GID=1000

HERMES_REPOSITORIES=/data/repos

HERMES_KNOWLEDGE=/data/knowledge

HERMES_SKILLS=/data/skills

HERMES_LOGS=/data/logs

# -- Chat stack (docker-compose.chat.yml) --
HERMES_CHAT_DOMAIN=chat.example.com
OLLAMA_MODEL=llama3.2

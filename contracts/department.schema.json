{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes-os.dev/contracts/department.schema.json",
  "title": "Department",
  "description": "Canonical Hermes OS Department — an organizational ownership unit.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "mission": {
      "type": "string"
    },
    "owner": {
      "type": ["string", "null"]
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ]
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
